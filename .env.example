# ============================================================
# FOTOTIME MX — Instrucciones de Variables de Entorno
# ============================================================
# Copia este archivo como `.env` y completa los valores reales.
# NUNCA subas tu `.env` real al repositorio.

# ─── Base de Datos PostgreSQL ───────────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/fototime_db?sslmode=disable"

# ─── Mercado Pago México ─────────────────────────────────────
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""

# ─── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Cloudflare R2 / AWS S3 (Almacenamiento de fotos) ───────
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="fototime-storage"
