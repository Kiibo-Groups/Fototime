# ============================================================
# FOTOTIME MX — .gitignore
# ============================================================

# ─── Dependencias ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Next.js Build ──────────────────────────────────────────
.next/
out/
build/
dist/

# ─── Variables de entorno (¡NUNCA subir al repo!) ───────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ─── Prisma Generated ───────────────────────────────────────
# El cliente generado se regenera con `npx prisma generate`
# NO ignoramos el schema porque es parte del código fuente
# src/generated/   # Si usas output custom, agrega aquí
prisma/*.db
prisma/*.db-journal

# ─── Logs ───────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# ─── Sistema Operativo ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─── IDEs y Editores ────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ─── TypeScript ─────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Coverage y Testing ─────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Cache y temporales ─────────────────────────────────────
.cache/
.turbo/
.vercel/
.netlify/
*.tmp
*.temp

# ─── Uploads locales (si se configura storage local en dev) ──
public/uploads/
uploads/

# ─── Archivos de secretos de servicios externos ─────────────
*.pem
*.key
*.crt
*.p12
*.pfx
service-account.json
google-credentials.json
firebase-adminsdk*.json
